{
  "description": "Vault capture/recall lifecycle: inject the matched subgraph on SessionStart and run a capture sweep on Stop/PreCompact. (The mid-session PostToolUse nudge was removed 2026-08-18 — each compliance cost a ~130K-token capture pass on top of the guaranteed end-of-session sweep.)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/skills/vault/scripts/inject-context.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/skills/vault/scripts/prompt-actualize.sh --reason=compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/skills/vault/scripts/prompt-actualize.sh"
          }
        ]
      }
    ]
  }
}
